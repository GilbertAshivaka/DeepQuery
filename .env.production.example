# ==============================================================
# Deep Query — PRODUCTION environment template
# Copy to `.env` at the repo root: `cp .env.production.example .env`
# then fill in every <...> value. docker-compose reads this via env_file.
#
# NOTE: infra URLs (DATABASE_URL, CHROMA_*, NEO4J_URI, CELERY_*, AGENT_REDIS_URL)
# are set inside docker-compose.yml using the internal service hostnames, so they
# are intentionally NOT here. Only set what the operator must choose: secrets,
# provider keys, Neo4j credentials, and the public origin.
# ==============================================================

APP_ENV=production

# ---- Auth + credential encryption (generate REAL values) ----
# Signing key for JWTs:
#   openssl rand -hex 32
JWT_SECRET_KEY=<openssl rand -hex 32>
# Fernet key for connector credentials at rest. REQUIRED in prod — if empty, a
# volatile key is generated per-restart and all stored connector creds are lost:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=<fernet-key>

# ---- External AI providers ----
GOOGLE_API_KEY=<gemini-embedding-key>
GROQ_API_KEY=<groq-key>

# ---- Neo4j ----
# NEO4J_PASSWORD is consumed twice: it sets the neo4j service's NEO4J_AUTH
# (via ${NEO4J_PASSWORD} in compose) AND the backend's connection password.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<strong-password>

# ---- Public origin (single domain; everything is proxied through nginx) ----
FRONTEND_URL=https://deepquery.example.com
CORS_ORIGINS=https://deepquery.example.com
# Base URL OAuth providers redirect back to (callback: <base>/api/connectors/auth/callback).
# Must be the public HTTPS origin, NOT localhost, or connector OAuth will fail.
CONNECTOR_OAUTH_REDIRECT_BASE=https://deepquery.example.com

# ---- Runtime ----
# The pilot VM is CPU-only — the dev example uses 'cuda', which would crash the
# reranker on a box with no GPU. Keep this 'cpu'.
RERANKER_DEVICE=cpu
DEPLOYMENT_MODE=cloud
