# ==============================================================
# Deep Query — Environment Configuration
# Copy this file to .env and fill in the required values.
# ==============================================================

# ---- Google AI (Gemini Embedding 2) ----
GOOGLE_API_KEY=

# ---- Groq (Llama 3.3 70B) ----
GROQ_API_KEY= 

# ---- ChromaDB ----
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=deepquery_dev_password

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Document Storage ----
DOCUMENT_STORE_PATH=./document_store

# ---- Database ----
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite:///./deepquery.db
# DATABASE_URL=postgresql://user:password@localhost:5432/deepquery

# ---- Application ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Reranker Model ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cuda

# ---- Embedding Dimensions ----
EMBEDDING_DIMENSIONS=3072

# ---- Chunking ----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=65
